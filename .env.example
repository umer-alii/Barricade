# Copy to .env and fill in. Works on any host (local, Vercel, Railway, VPS…)
#   cp .env.example .env

# Online multiplayer — free at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Accounts / friends / chat / ranked — free at https://supabase.com
# Run supabase/schema.sql in the Supabase SQL editor after creating a project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
